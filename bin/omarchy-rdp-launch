#!/usr/bin/env bash
# Launch a saved RDP connection.
#
# This is a working standalone CLI, not just a shim for the bar widget:
#   omarchy-rdp-launch windows-build-server
#   omarchy-rdp-launch windows-build-server --dry-run
# Running it in a terminal is how you debug a connection that misbehaves.
#
# Password handling is the point of this script. FreeRDP warns that "passing
# credentials or secrets via command line might expose these in the process
# list", so nothing here ever puts the password in argv. Instead the whole
# argument list — password included — goes to FreeRDP on file descriptor 3 via
# /args-from:fd:3, leaving `ps` showing only `xfreerdp3 /args-from:fd:3`.
# fd is preferred over /args-from:env: because an environment variable is still
# readable through /proc/<pid>/environ.
set -uo pipefail

XFREERDP=/usr/bin/xfreerdp3
# How long a session gets to shut down cleanly before it is killed outright.
# See on_term() for why an escalation is needed at all.
TERM_GRACE=${OMARCHY_RDP_TERM_GRACE:-10}
JQ=/usr/bin/jq
HYPRCTL=/usr/bin/hyprctl
FLOCK=/usr/bin/flock
NOTIFY=/usr/bin/omarchy-notification-send

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
SECRET_HELPER="$SELF_DIR/omarchy-rdp-secret"

CONFIG_DIR=${OMARCHY_RDP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-rdp}
CONFIG_FILE="$CONFIG_DIR/connections.json"

# shellcheck source=bin/lib-state-dir.sh
. "$SELF_DIR/lib-state-dir.sh"
# shellcheck source=bin/lib-process.sh
. "$SELF_DIR/lib-process.sh"
# shellcheck source=bin/lib-window.sh
. "$SELF_DIR/lib-window.sh"

GLYPH_OK=$'\U000F08B9'
GLYPH_FAIL=$'\U000F0159'

# Report a failure where the panel can actually see it.
#
# Printing to stderr alone is not enough: nothing reads it. With no state file
# the status helper reports nothing for this id, and the panel falls back to its
# 12 second pending timeout, which says "The launcher never started, check that
# bin/ is executable" whatever the real cause was. For the most likely failure,
# a locked keyring, that sends the user to look at file permissions (#18).
#
# Only once state_file is known, and never for --test or --dry-run: those are
# probes, and neither should leave a session behind.
die() {
  local message=$1 code=${2:-1}
  printf 'omarchy-rdp-launch: %s\n' "$message" >&2
  # Not when another launcher still owns this id: recording our failure over its
  # state would report a healthy session as dead (#20).
  if [[ -n ${state_file:-} ]] && (( ! test_only && ! dry_run )) \
     && ! state_owned_by_live_launcher; then
    write_state exited "$code" "$message"
  fi
  exit "$code"
}

id=""
dry_run=0
test_only=0
notify_on_end=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    # Reachability + credential probe. `+auth-only` makes FreeRDP authenticate
    # and stop before opening a window, so it answers "would this connect?"
    # without starting a session. Prints nothing; the exit code is the answer.
    --test) test_only=1 ;;
    # The bar widget passes this through from its notifyOnDisconnect setting.
    # Failures always notify; this adds a notification for a clean end too.
    --notify) notify_on_end=1 ;;
    -h|--help)
      printf 'usage: omarchy-rdp-launch <connection-id> [--dry-run] [--notify]\n\n'
      printf '  --dry-run  print the FreeRDP argument list (password redacted) and exit\n'
      printf '  --test     authenticate only, then exit with FreeRDP status; opens no window\n'
      printf '  --notify   also send a desktop notification when the session ends cleanly\n'
      exit 0
      ;;
    -*) die "unknown option: $arg" 64 ;;
    *) if [[ -z "$id" ]]; then id=$arg; else die "unexpected argument: $arg" 64; fi ;;
  esac
done

[[ -n "$id" ]] || die "usage: omarchy-rdp-launch <connection-id> [--dry-run]" 64
[[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid connection id: $id" 64
[[ -x "$JQ" ]] || die "jq not found at $JQ"
# The xfreerdp3 check lives with the paths that actually run it. --dry-run only
# renders the argument list, and being able to inspect that on a machine where
# FreeRDP is not installed yet is precisely when it is most useful.
[[ -r "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE"

# ------------------------------------------------------------------ the config

conn=$("$JQ" -e --arg id "$id" '.connections[] | select(.id == $id)' "$CONFIG_FILE" 2>/dev/null) \
  || die "no connection with id '$id' in $CONFIG_FILE"

field() { printf '%s' "$conn" | "$JQ" -r --arg d "${2-}" '.'"$1"' // $d'; }

host=$(field host)
name=$(field name)
port=$(field port 3389)
user=$(field user)
domain=$(field domain)
cert=$(field options.cert tofu)
scale=$(field options.scale 100)

[[ -n "$host" ]] || die "connection '$id' has no host"
[[ -n "$user" ]] || die "connection '$id' has no user"
case "$cert" in tofu|ignore|deny) ;; *) cert=tofu ;; esac
# FreeRDP's /scale: only accepts these three values (xfreerdp3 --help).
case "$scale" in 100|140|180) ;; *) scale=100 ;; esac

# ------------------------------------------------------- the argument list

# Mirrors Model.js buildArgs(). If you change the order or content here, change
# it there too — tests/model.test.js asserts the shape, and the panel's dry-run
# preview renders the Model.js version.
args=()
if [[ "$port" == "3389" || -z "$port" ]]; then
  args+=("/v:$host")
else
  args+=("/v:$host:$port")
fi
args+=("/u:$user")
[[ -n "$domain" ]] && args+=("/d:$domain")
args+=("/cert:$cert")

# ---------------------------------------------------------------- sizing

# These mirror Model.js. Keep the two in step: tests/launcher.test.sh compares
# the argument list this script builds against the one Model.js builds for the
# same connection, so any drift fails the build.
AUTO_MAX_WIDTH=2560
AUTO_MAX_HEIGHT=1440
MIN_WIDTH=640
MIN_HEIGHT=480
MAX_WIDTH=7680
MAX_HEIGHT=4320
FALLBACK_AUTO_WIDTH=1920
FALLBACK_AUTO_HEIGHT=1080

# The monitor the session will open on, in physical pixels. OMARCHY_RDP_AUTO_SIZE
# overrides the lookup, which is what keeps the parity test deterministic on a
# build machine that has no compositor to ask.
monitor_size() {
  local out=""
  if [[ -n ${OMARCHY_RDP_AUTO_SIZE:-} ]]; then
    printf '%s' "$OMARCHY_RDP_AUTO_SIZE"
    return
  fi
  if [[ -x $HYPRCTL ]]; then
    out=$("$HYPRCTL" monitors -j 2>/dev/null \
      | "$JQ" -r 'map(select(.focused))[0] | if . then "\(.width)x\(.height)" else empty end' 2>/dev/null)
  fi
  if [[ -z $out ]]; then
    printf '%sx%s' "$FALLBACK_AUTO_WIDTH" "$FALLBACK_AUTO_HEIGHT"
  else
    printf '%s' "$out"
  fi
}

# Clamp each axis on its own, then round the width to a multiple of 4 and the
# height to a multiple of 2. Same arithmetic as Model.js autoResolution().
auto_resolution() {
  local w=${1:-0} h=${2:-0}
  [[ $w =~ ^[0-9]+$ ]] && (( w > 0 )) || w=$FALLBACK_AUTO_WIDTH
  [[ $h =~ ^[0-9]+$ ]] && (( h > 0 )) || h=$FALLBACK_AUTO_HEIGHT
  (( w > AUTO_MAX_WIDTH )) && w=$AUTO_MAX_WIDTH
  (( h > AUTO_MAX_HEIGHT )) && h=$AUTO_MAX_HEIGHT
  w=$(( w / 4 * 4 ))
  h=$(( h / 2 * 2 ))
  (( w < MIN_WIDTH )) && w=$MIN_WIDTH
  (( h < MIN_HEIGHT )) && h=$MIN_HEIGHT
  printf '%sx%s' "$w" "$h"
}

# "auto" or WIDTHxHEIGHT. Anything unparseable falls back to auto rather than
# reaching FreeRDP, matching Model.js normalizeResolution().
resolve_size() {
  local raw w h mon
  raw=$(printf '%s' "$conn" | "$JQ" -r '(.options.resolution // "auto") | tostring | ascii_downcase')
  raw=${raw//×/x}
  raw=${raw//[[:space:]]/}
  if [[ $raw =~ ^([0-9]{3,5})x([0-9]{3,5})$ ]]; then
    w=${BASH_REMATCH[1]}
    h=${BASH_REMATCH[2]}
    if (( w >= MIN_WIDTH && w <= MAX_WIDTH && h >= MIN_HEIGHT && h <= MAX_HEIGHT )); then
      printf '%sx%s' "$w" "$h"
      return
    fi
  fi
  mon=$(monitor_size)
  auto_resolution "${mon%x*}" "${mon#*x}"
}

# displayMode, falling back to the older dynamicResolution boolean the same way
# Model.js normalizeDisplayMode() does.
display_mode() {
  local mode
  mode=$(printf '%s' "$conn" | "$JQ" -r '(.options.displayMode // "") | tostring | ascii_downcase')
  case $mode in
    fixed|scaled|dynamic) printf '%s' "$mode"; return ;;
  esac
  if [[ $(printf '%s' "$conn" | "$JQ" -r 'if .options.dynamicResolution == false then "false" else "true" end') == "false" ]]; then
    printf 'fixed'
  else
    printf 'dynamic'
  fi
}

# Careful with jq's `//`: it substitutes for false as well as null, so
# `.options.clipboard // true` would turn an explicit false back into true and
# silently ignore the user switching clipboard off. Test for false directly.
bool_field() {
  # prints "false" only for an explicit false; anything else (including a
  # missing key) prints "true", matching Model.js normalizeOptions().
  printf '%s' "$conn" | "$JQ" -r 'if .'"$1"' == false then "false" else "true" end'
}
if [[ $(bool_field options.clipboard) == "false" ]]; then
  args+=("-clipboard")
else
  args+=("+clipboard")
fi
# "100" is native size; omit the flag rather than pass a no-op /scale:100.
[[ "$scale" != "100" ]] && args+=("/scale:$scale")
# Without a size FreeRDP picks 1024x768, a postage stamp on a modern display.
# Emitted for every mode: under "dynamic" it is the size the desktop starts at
# before the first resize. FreeRDP exits 22 if /smart-sizing and
# +dynamic-resolution are both present, so exactly one of them is emitted.
args+=("/size:$(resolve_size)")
case $(display_mode) in
  scaled)  args+=("/smart-sizing") ;;
  dynamic) args+=("+dynamic-resolution") ;;
esac

# One /drive: per mapping — verified additive in FreeRDP 3.
while IFS=$'\t' read -r dname dpath; do
  [[ -n "$dname" && -n "$dpath" ]] || continue
  args+=("/drive:$dname,$dpath")
done < <(printf '%s' "$conn" | "$JQ" -r '(.drives // [])[] | [.name, .path] | @tsv')

wm_class="omarchy-rdp-$id"
args+=("/wm-class:$wm_class")
# jq's // only substitutes for null/false, so an empty name survives it.
# Fall back to the id, which is what Model.js parseConfig() backfills.
args+=("/t:${name:-$id}")

if (( dry_run )); then
  printf '%s\n' "${args[@]}" '/p:<redacted>'
  printf '\n# %s /args-from:fd:3   (%d arguments, none of them on the command line)\n' \
    "$XFREERDP" "$(( ${#args[@]} + 1 ))"
  exit 0
fi


# Whether the state file currently belongs to a *different* launcher that is
# still alive.
#
# die() writes phase "exited", and the status helper only re-verifies liveness
# for "connecting" and "connected", so any other phase is believed. A second
# launch of an already-connected id that then failed would therefore mark the
# healthy session dead, and the panel would drop its Disconnect while FreeRDP
# was still running (#20).
#
# rdp_same_process is the same identity check the status helper and disconnect
# use: a bare pid proves nothing, because pids are recycled. A stale file whose
# launcher is gone fails that check and is free to overwrite, which is what
# keeps a crashed session from blocking the next launch forever.
state_owned_by_live_launcher() {
  [[ -n ${state_file:-} && -r ${state_file:-} ]] || return 1
  local pid ticks
  pid=$("$JQ" -r '.pid // 0' "$state_file" 2>/dev/null) || return 1
  ticks=$("$JQ" -r '.startTicks // ""' "$state_file" 2>/dev/null)
  [[ $pid =~ ^[0-9]+$ ]] && (( pid > 0 )) || return 1
  # Our own state file. Updating that is the entire point of write_state.
  (( pid == $$ )) && return 1
  rdp_same_process "$pid" "$ticks"
}

write_state() {
  local phase=$1 exit_code=${2:-null} message=${3:-}
  local tmp="$state_file.$$"
  local established=false
  [[ -e ${established_file:-} ]] && established=true
  "$JQ" -n \
    --arg id "$id" --arg phase "$phase" --arg wmClass "$wm_class" \
    --arg host "$host" --arg message "$message" --arg startTicks "$start_ticks" \
    --argjson pid "$$" --argjson startedAt "$started_at" --argjson exitCode "$exit_code" \
    --argjson established "$established" \
    '{id: $id, pid: $pid, startTicks: $startTicks, phase: $phase, wmClass: $wmClass,
      host: $host, startedAt: $startedAt, exitCode: $exitCode, established: $established,
      message: $message}' > "$tmp" \
    && mv -f "$tmp" "$state_file"
}

stopped=0
child=0
# Initialised alongside child so on_term() cannot trip over an unset variable
# if a signal lands between starting FreeRDP and recording its identity.
child_ticks=""
# A TERM aimed at this script (that is how the panel's Disconnect works) has to
# reach xfreerdp3 too, so the session actually closes. The trap body is
# evaluated when the signal arrives, by which point $child is set.
# shellcheck disable=SC2317  # reached via `trap`, which shellcheck cannot see
on_term() {
  stopped=1
  if [[ $child -gt 0 ]]; then
    # Escalates to SIGKILL after a grace period: FreeRDP acknowledges SIGTERM
    # and then does not necessarily exit. See rdp_terminate in lib-process.sh.
    rdp_terminate "$child" "$child_ticks" "$TERM_GRACE" || true
  fi
  if [[ ${watcher:-0} -gt 0 ]]; then
    kill -TERM "$watcher" 2>/dev/null || true
  fi
  return 0
}
trap on_term TERM INT

# ------------------------------------------------------------------ state file

# Skipped entirely for --test. A probe is not a session: it needs no state
# file, and running this for one is actively harmful, because the cleanup
# below removes $id.established. Probing an id that is *currently connected*
# would wipe the marker for that live session, and when it later dropped the
# launcher would fall back to the connect-time message this whole change
# exists to stop it printing. The Test button is hidden on live rows, but the
# `t` shortcut and the CLI have no such guard.
#
# It also means --test still works where the state directory cannot be created.
if (( ! test_only )); then

  STATE_DIR=$(rdp_state_dir) || die "cannot determine a state directory"
  # `mkdir -p -m` would set the mode on the deepest directory only, so chmod
  # separately; rdp_state_dir_ok then confirms the result rather than assuming it.
  mkdir -p "$STATE_DIR" || die "could not create $STATE_DIR"
  chmod 700 "$STATE_DIR" || die "could not restrict $STATE_DIR to this user"
  rdp_state_dir_ok "$STATE_DIR" || die "refusing to use state directory $STATE_DIR"
  state_file="$STATE_DIR/$id.state"
  log_file="$STATE_DIR/$id.log"
  # Written by the watcher below once this session's window appears. A separate
  # file rather than a field so the watcher never races write_state for the state
  # file; write_state reads it and folds it into the JSON.
  established_file="$STATE_DIR/$id.established"

  # Serialise launches for this id before reading anything (#22).
  #
  # The ownership check below is a read, so without this two launchers can both
  # pass it before either writes a state file, and both then run FreeRDP against
  # one wm-class, one state file and one keyring entry. Reproduced by starting
  # two at once: both proceeded.
  #
  # The kernel releases the lock when this process dies, SIGKILL included, so
  # there is no stale lock to reap and the file is never removed: unlinking a
  # lock another process may be holding is its own race.
  lock_file="$STATE_DIR/$id.lock"
  if [[ -x $FLOCK ]]; then
    exec 9>"$lock_file" || die "could not open $lock_file"
    if ! "$FLOCK" -n 9; then
      # Deliberately not through die(). The launcher that holds the lock may not
      # have written its state file yet, so there would be nothing to protect,
      # and recording this failure would land on a session about to start.
      printf 'omarchy-rdp-launch: a session for %s is already starting\n' "$id" >&2
      exit 1
    fi
  fi

  # Checked before anything below touches the directory. One connection id means
  # one session: two would share a wm-class, a state file and a keyring entry,
  # so a second launcher cannot coexist with the first. The panel hides Connect
  # on a live row, but the `c` shortcut and this CLI have no such guard.
  #
  # Order matters. The cleanup below removes $id.established, so refusing after
  # it would protect the live session's state file while deleting the marker
  # beside it, and that session would then report a connect-time failure when it
  # later dropped: the exact thing this series keeps fixing.
  if state_owned_by_live_launcher; then
    die "a session for '$id' is already running"
  fi

  # Any leftover marker belongs to a previous run of *this* id whose launcher is
  # gone, so it is ours to clear. It has to happen here rather than after the
  # password lookup: a keyring failure would otherwise fold a stale marker into
  # its own state file as established, and report "Connection lost" for a launch
  # that never connected.
  rm -f "$established_file"
  trap 'rm -f "$established_file"' EXIT
  started_at=$(printf '%(%s)T' -1)

  # Recorded so readers can tell this process from a later one that inherits its
  # pid. Without it `kill -0` is the only check available, and that cannot
  # distinguish our launcher from whatever recycled the number.
  start_ticks=$(rdp_start_ticks $$) || die "cannot read /proc/$$/stat to identify this process"
fi

# --------------------------------------------------------------- the password

# From here on `password` is the only copy. It goes into the fd-3 list and
# nowhere else: not argv, not the environment, not a temp file, not the log.
# $? is captured on its own line, not inside `if ! ...`, where it would be the
# status of the negation and always 0. That mistake is what made a locked
# keyring read as "no password stored" once before, in #1.
password=$("$SECRET_HELPER" lookup "$id")
lookup_status=$?
if (( lookup_status != 0 )); then
  # The helper distinguishes these; the launcher used to flatten both into
  # "no password stored" and send the user to fix the wrong thing.
  (( lookup_status == 124 )) \
    && die "The keyring did not respond, it may be locked" 124
  # The how-to-fix goes to stderr only. die()'s message becomes a row label in
  # the panel, so it stays to one short line; a two-line message with a file
  # path in it would be unreadable there.
  printf 'omarchy-rdp-launch: save one in the RDP panel, or run:\n  %s store %s\n' \
    "$SECRET_HELPER" "$id" >&2
  die "No password stored for this connection"
fi
args+=("/p:$password")
unset password

# --------------------------------------------------------------------- test

if (( test_only )); then
  [[ -x "$XFREERDP" ]] || die "xfreerdp3 not found at $XFREERDP (install the freerdp package)"
  # Quiet: a probe should say nothing and mean it through its exit code.
  args+=("+auth-only" "/log-level:OFF")
  "$XFREERDP" /args-from:fd:3 3< <(printf '%s\n' "${args[@]}") >/dev/null 2>&1
  exit $?
fi


# Checked here rather than earlier so a missing FreeRDP is reported through the
# state file like every other failure. Before the state file exists, die() has
# nowhere to put the reason and the panel blames bin/ instead (#18).
[[ -x "$XFREERDP" ]] || die "xfreerdp3 not found, install the freerdp package"

write_state connecting

# ------------------------------------------------------------------- run it

# `xfreerdp3` stays in the foreground for the whole session, so this script is
# the session's lifetime and $! is not needed. stderr is kept so a failure can
# be explained after the fact; stdout is not interesting.
# FreeRDP does not log credentials, but the log is the one file this script
# creates, so keep it owner-only regardless.
: > "$log_file"
chmod 600 "$log_file" 2>/dev/null || true

# Backgrounded rather than exec'd so the TERM trap above can forward the signal.
# 9>&- keeps the lock out of the child. fds survive exec, so FreeRDP would
# otherwise hold it too, and an orphaned FreeRDP whose launcher was killed would
# keep the id locked while the status helper reported the session stopped: the
# panel would offer Connect and the launcher would refuse it.
"$XFREERDP" /args-from:fd:3 3< <(printf '%s\n' "${args[@]}") \
  >/dev/null 2>>"$log_file" 9>&- &
child=$!
unset args
# Recorded now so the escalation in on_term() can prove the pid it is about to
# SIGKILL is still FreeRDP. Without this a delayed kill is the same recycled-pid
# bug that #3 fixed in disconnect, just moved somewhere new.
child_ticks=$(rdp_start_ticks "$child" 2>/dev/null) || child_ticks=""

# Record that this session's window appeared.
#
# FreeRDP maps nothing until the connection actually succeeds, so the window is
# what separates "the link died" from "we never got in". It has to be watched
# for while the session is alive: by the time the exit message is written the
# window is long gone, and the exit code cannot tell the two cases apart. 147
# is the same code whether the port never spoke RDP or an hour-old session was
# reset by the peer.
#
# Stops as soon as it finds the window, so the usual cost is a couple of polls.
watch_for_window() {
  local classes tries=0
  # Ten minutes at two-second intervals. A session that has not mapped a window
  # by then is not going to, and there is no point watching for the rest of it.
  while (( tries < 300 )) && kill -0 "$child" 2>/dev/null; do
    classes=$(rdp_window_classes) || classes=""
    if rdp_class_present "$wm_class" "$classes"; then
      : > "$established_file"
      return 0
    fi
    tries=$((tries + 1))
    sleep 2
  done
}
watcher=0
# 9>&- for the same reason as the FreeRDP child: this subshell would otherwise
# hold the lock, and it polls for up to ten minutes. A launcher killed outright
# while FreeRDP survives would leave the watcher running and the id locked,
# while the status helper reported the session stopped. The lock should track
# the launcher, which is what owns the state file.
watch_for_window 9>&- &
watcher=$!

# `wait` returns early when a trapped signal arrives, with the child still
# running; the second wait collects its real exit status.
wait "$child"
status=$?
if (( status > 128 )) && kill -0 "$child" 2>/dev/null; then
  wait "$child"
  status=$?
fi

if [[ ${watcher:-0} -gt 0 ]]; then
  kill -TERM "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
fi
established=0
[[ -e "$established_file" ]] && established=1

if (( stopped )) || [[ $status -eq 143 || $status -eq 130 ]]; then
  write_state stopped 0 "Disconnected"
  if (( notify_on_end )) && [[ -x "$NOTIFY" ]]; then
    "$NOTIFY" -g "$GLYPH_OK" "RDP: ${name:-$id}" "Disconnected" || true
  fi
  exit 0
fi

if [[ $status -eq 0 ]]; then
  write_state exited 0 "Session ended"
  if (( notify_on_end )) && [[ -x "$NOTIFY" ]]; then
    "$NOTIFY" -g "$GLYPH_OK" "RDP: ${name:-$id}" "Session ended" || true
  fi
  exit 0
fi

# Turn the exit code into something a human can act on. This table mirrors
# EXIT_MESSAGES in Model.js, and tests/launcher.test.sh asserts the two agree.
# Both are transcribed from `enum XF_EXIT_CODE` in FreeRDP's
# client/X11/xfreerdp.h; codes 1-11 say how a live session ended, and anything
# from 128 up is xfreerdp never getting a session at all.
case $status in
  1)   message="Disconnected" ;;
  2)   message="Signed out on the remote machine" ;;
  3)   message="Disconnected after being idle" ;;
  4)   message="Logon timed out" ;;
  5)   message="Replaced by another connection" ;;
  6)   message="The server ran out of memory" ;;
  7)   message="The server refused the connection" ;;
  8)   message="The server refused the connection (FIPS policy)" ;;
  9)   message="Insufficient user privileges" ;;
  10)  message="Fresh credentials are required" ;;
  11)  message="Disconnected by the user" ;;
  128) message="Bad FreeRDP arguments (plugin bug, please report)" ;;
  129) message="FreeRDP ran out of memory" ;;
  130) message="Protocol error" ;;
  131) message="Could not connect to the host" ;;
  132) message="Authentication failed" ;;
  133) message="Security negotiation failed" ;;
  134) message="Logon failure, check the username and domain" ;;
  135) message="Account locked out" ;;
  136) message="Pre-connect failed" ;;
  137) message="Connection failed for an unspecified reason" ;;
  138) message="Post-connect failed" ;;
  139) message="DNS error" ;;
  140) message="Host not found" ;;
  141) message="Could not connect, host unreachable or RDP not listening" ;;
  142) message="MCS connect failed" ;;
  143) message="TLS handshake failed" ;;
  144) message="Insufficient privileges" ;;
  145) message="Connection cancelled" ;;
  147) message="Transport failed, is that port really RDP?" ;;
  148) message="Password expired" ;;
  149) message="Password must be changed before signing in" ;;
  150) message="Kerberos KDC unreachable" ;;
  151) message="Account disabled" ;;
  152) message="Password expired" ;;
  153) message="Client revoked" ;;
  154) message="Wrong password" ;;
  155) message="Access denied" ;;
  156) message="Account restriction" ;;
  157) message="Account expired" ;;
  158) message="Logon type not granted to this account" ;;
  159) message="No credentials were supplied" ;;
  160) message="The remote machine is still booting" ;;
  161) message="The server requires NLA" ;;
  255) message="Unknown FreeRDP error" ;;
  *)   if (( status >= 128 )); then message="Connection failed (FreeRDP exit $status)"
       else message="Could not start FreeRDP (exit $status)"; fi ;;
esac

# The ordinary ways a live session finishes. Mirrors NORMAL_END_CODES in
# Model.js. Not all of 1-11: a logon timeout or a refused connection ended the
# session too, but those are failures worth shouting about.
is_normal_end() {
  case $1 in
    1|2|3|5|11) return 0 ;;
    *) return 1 ;;
  esac
}

# A session that was up and then broke did not fail to *connect*, so a
# connect-time diagnostic is actively misleading: telling someone to check
# whether the port is really RDP, about a link that worked for an hour, sends
# them to look at something that was never the problem.
urgent=1
if is_normal_end "$status"; then
  urgent=0
elif (( established )); then
  message="Connection lost"
  urgent=0
fi

write_state exited "$status" "$message"

if [[ -x "$NOTIFY" ]]; then
  if (( urgent )); then
    "$NOTIFY" -g "$GLYPH_FAIL" -u critical "RDP: ${name:-$id}" "$message" || true
  else
    "$NOTIFY" -g "$GLYPH_OK" "RDP: ${name:-$id}" "$message" || true
  fi
fi

printf 'omarchy-rdp-launch: %s\n' "$message" >&2
printf 'FreeRDP output is in %s\n' "$log_file" >&2
exit "$status"
