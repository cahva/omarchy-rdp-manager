#!/usr/bin/env bash
# Store, look up and delete RDP passwords in the system keyring (libsecret).
#
# The password is only ever moved over a pipe: `store` reads it from stdin and
# hands it to secret-tool's stdin, and `lookup` writes it to stdout. It is
# never an argv element, so it cannot appear in `ps` output.
#
# Usage:
#   omarchy-rdp-secret store  <id> [label]   # password on stdin
#   omarchy-rdp-secret lookup <id>           # password on stdout, exit 1 if unset
#   omarchy-rdp-secret has    <id>           # exit 0 if a password is stored
#   omarchy-rdp-secret delete <id>
set -uo pipefail

# Absolute paths throughout: ~/.local/bin mise wrappers resolve differently in
# a login shell than in the Quickshell session, and omarchy's bar.run() goes
# through `bash -lc`, which activates mise.
SECRET_TOOL=/usr/bin/secret-tool
SETSID=/usr/bin/setsid
SERVICE=omarchy-rdp

# If the keyring is locked, secret-tool blocks on a GUI prompt with no headless
# fallback. Cap every call so a locked keyring surfaces as an error instead of
# wedging the caller (and, for the bar widget, its poll timer).
TIMEOUT_BIN=/usr/bin/timeout
LOOKUP_TIMEOUT=10
STORE_TIMEOUT=20

# Never exit 0 from an error path. The panel branches on the exit status, so a
# zero here would report a password as saved when it was not.
die() {
  local code=${2:-1}
  (( code == 0 )) && code=1
  printf 'omarchy-rdp-secret: %s\n' "$1" >&2
  exit "$code"
}

[[ -x "$SECRET_TOOL" ]] || die "secret-tool not found at $SECRET_TOOL (install the libsecret package)"

action=${1:-}
id=${2:-}
[[ -n "$action" ]] || die "usage: omarchy-rdp-secret {store|lookup|has|delete} <id> [label]" 64
[[ -n "$id" ]] || die "missing connection id" 64
[[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid connection id: $id" 64

case "$action" in
  store)
    label=${3:-"Omarchy RDP: $id"}
    # secret-tool reads the secret from stdin by design.
    #
    # Run it plainly and capture $? on the next line. Inside `if ! cmd; then`, $?
    # is the status of the negation — always 0 when cmd failed — which made every
    # failed write exit 0 and the panel report the password as saved.
    # setsid strips the controlling terminal before secret-tool runs: on this
    # system secret-tool's password prompt opens /dev/tty directly rather than
    # reading fd 0, so whenever a controlling terminal exists (a real terminal,
    # or Quickshell's own session) the prompt waits on a tty nobody is typing
    # into and the timeout above is what eventually kills it. No controlling
    # terminal makes secret-tool fall back to reading the piped stdin instead.
    "$TIMEOUT_BIN" "$STORE_TIMEOUT" "$SETSID" "$SECRET_TOOL" store \
      --label="$label" service "$SERVICE" connection "$id"
    status=$?
    if (( status != 0 )); then
      (( status == 124 )) && die "timed out storing the password — the keyring may be locked" 124
      die "secret-tool store failed (exit $status)" "$status"
    fi
    ;;

  lookup)
    # `secret-tool lookup` exits 1 on no match. Its sibling `search` exits 0
    # with empty stdout instead, which is why lookup is the one used here.
    #
    # As in `store`, $? is captured outside any negation. Doing it inside one made
    # the 124 branch unreachable, so a locked keyring was reported as "no password
    # stored" and pointed the user at the wrong problem.
    out=$("$TIMEOUT_BIN" "$LOOKUP_TIMEOUT" "$SECRET_TOOL" lookup service "$SERVICE" connection "$id" 2>/dev/null)
    status=$?
    if (( status != 0 )); then
      (( status == 124 )) && die "timed out reading the password — the keyring may be locked" 124
      exit 1
    fi
    [[ -n "$out" ]] || exit 1
    printf '%s' "$out"
    ;;

  has)
    "$TIMEOUT_BIN" "$LOOKUP_TIMEOUT" "$SECRET_TOOL" lookup service "$SERVICE" connection "$id" >/dev/null 2>&1
    ;;

  delete)
    # clear exits non-zero when nothing matched; that is not an error for us.
    "$TIMEOUT_BIN" "$LOOKUP_TIMEOUT" "$SECRET_TOOL" clear service "$SERVICE" connection "$id" >/dev/null 2>&1 || true
    ;;

  *)
    die "unknown action: $action" 64
    ;;
esac
